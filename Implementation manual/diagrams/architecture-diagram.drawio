        <mxCell id="sw_s2" parent="tier_data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=1.5;fontSize=10.5;align=left;spacingLeft=6;" value="&lt;b&gt;Edge Egress Switch (s2)&lt;/b&gt;&lt;hr&gt;• &lt;b&gt;FF Group 200 Installed&lt;/b&gt;&lt;br&gt;  - Bucket 0: watch_port=3 (to s3)&lt;br&gt;  - Bucket 1: watch_port=4 (to s1)&lt;br&gt;• &lt;b&gt;Linux HTB Queues Attached:&lt;/b&gt;&lt;br&gt;  - Queue 0: Bulk Max 4.0 Mbps&lt;br&gt;  - Queue 1: Priority 8.0-10.0 Mbps&lt;br&gt;• &lt;b style=&#39;color:#b91c1c;&#39;&gt;Switch-Local Recovery: 41.0 ms&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="270" x="890" y="45" as="geometry" />
        </mxCell>
