        <mxCell id="callout_result" parent="tier_data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=1.5;fontSize=10.5;fontColor=#9a3412;align=center;" value="&lt;b&gt;BENCHMARKED PERFORMANCE GAINS (45 Trials):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Hardware Fast-Failover:&lt;/b&gt; 41.0 ms (37.4x faster than Reactive SDN) | &lt;b&gt;Packet Loss:&lt;/b&gt; 0.5% (vs 19.1%)&lt;br&gt;• &lt;b&gt;AI Congestion Self-Healing:&lt;/b&gt; Priority Latency 7.6 ms (84% drop) | &lt;b&gt;Goodput:&lt;/b&gt; +129% (9.4 Mbps)" vertex="1">
