        <mxCell id="bus_nb_stats" edge="1" parent="1" style="shape=flexArrow;endArrow=classic;startArrow=classic;html=1;fillColor=#e9d5ff;strokeColor=#9333ea;fontSize=11;fontColor=#581c87;align=center;" value="&lt;b&gt;Northbound Telemetry Stream&lt;/b&gt; (JSON / REST API / Unix Socket)&#xa;Tx/Rx Bytes, Drop Counters, Port Carrier Status Polled Every 5.0 Seconds">
