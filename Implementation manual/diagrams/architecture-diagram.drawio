        <mxCell id="sw_s1" parent="tier_data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=1.5;fontSize=10.5;align=left;spacingLeft=6;" value="&lt;b&gt;Edge Ingress Switch (s1)&lt;/b&gt;&lt;hr&gt;• &lt;b&gt;FF Group 100 Installed&lt;/b&gt;&lt;br&gt;  - Bucket 0: watch_port=3 (to s3)&lt;br&gt;  - Bucket 1: watch_port=4 (to s2)&lt;br&gt;• &lt;b&gt;Linux HTB Queues Attached:&lt;/b&gt;&lt;br&gt;  - Queue 0: Bulk Max 4.0 Mbps&lt;br&gt;  - Queue 1: Priority 8.0-10.0 Mbps&lt;br&gt;• &lt;b style=&#39;color:#b91c1c;&#39;&gt;Switch-Local Recovery: 41.0 ms&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="270" x="40" y="45" as="geometry" />
        </mxCell>
        <mxCell id="sw_s3" parent="tier_data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=1.5;fontSize=10.5;align=left;spacingLeft=6;" value="&lt;b&gt;Core Backbone Switch (s3)&lt;/b&gt;&lt;hr&gt;• High-Capacity Core Transit Trunk&lt;br&gt;• s3-eth1 &amp;lt;---&amp;gt; s1-eth3 (100 Mbps)&lt;br&gt;• s3-eth2 &amp;lt;---&amp;gt; s2-eth3 (100 Mbps)&lt;br&gt;• Standard L2/L3 OpenFlow Forwarding&lt;br&gt;• Zero Controller Overhead in Transit" vertex="1">
          <mxGeometry height="150" width="250" x="480" y="45" as="geometry" />
