        <mxCell id="tier_ctrl" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=13;fontStyle=1;startSize=30;rounded=1;" value="TIER 2: CONTROL PLANE (OS-Ken / Ryu SDN Controller - OpenFlow 1.3)" vertex="1">
          <mxGeometry height="210" width="1200" x="50" y="350" as="geometry" />
        </mxCell>
        <mxCell id="ctrl_bridge" parent="tier_ctrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7dd3fc;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;AI-SDN REST Bridge&lt;/b&gt;&lt;br&gt;&lt;i&gt;(controller/ai_sdn_bridge.py)&lt;/i&gt;&lt;hr&gt;• REST Endpoint: &lt;b&gt;http://127.0.0.1:8080&lt;/b&gt;&lt;br&gt;• Exports Structured Switch Metrics&lt;br&gt;• Dispatches Layer-2 AI Reroute Orders&lt;br&gt;• Master Unified Event Timeline Logger" vertex="1">
          <mxGeometry height="145" width="260" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="ctrl_classifier" parent="tier_ctrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7dd3fc;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;QoS Flow Classifier&lt;/b&gt;&lt;br&gt;&lt;i&gt;(controller/flow_classifier.py)&lt;/i&gt;&lt;hr&gt;• Inspects IPv4 DSCP &amp;amp; L4 UDP/TCP Ports&lt;br&gt;• &lt;b&gt;Voice/Video (UDP 5001/5002)&lt;/b&gt; → Queue 1&lt;br&gt;• &lt;b&gt;Bulk Data (TCP 5201)&lt;/b&gt; → Queue 0&lt;br&gt;• Injects OpenFlow Metadata Flow Tags&lt;br&gt;• Priority Isolation Safeguards" vertex="1">
          <mxGeometry height="145" width="260" x="330" y="45" as="geometry" />
        </mxCell>
        <mxCell id="ctrl_ff" parent="tier_ctrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7dd3fc;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Fast-Failover Group Manager&lt;/b&gt;&lt;br&gt;&lt;i&gt;(controller/ff_groups.py)&lt;/i&gt;&lt;hr&gt;• Installs &lt;b&gt;OFPGT_FF&lt;/b&gt; Groups 100 &amp;amp; 200&lt;br&gt;• &lt;b&gt;Bucket 0 (Primary):&lt;/b&gt; watch_port=3, Q1&lt;br&gt;• &lt;b&gt;Bucket 1 (Backup):&lt;/b&gt; watch_port=4, Q1&lt;br&gt;• &lt;b&gt;Queue Preservation:&lt;/b&gt; set_queue in BOTH!&lt;br&gt;• Zero-Loss Hardware Liveness Monitoring" vertex="1">
          <mxGeometry height="145" width="260" x="630" y="45" as="geometry" />
        </mxCell>
        <mxCell id="ctrl_telemetry" parent="tier_ctrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7dd3fc;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;OpenFlow 1.3 Core &amp;amp; Modes&lt;/b&gt;&lt;br&gt;&lt;i&gt;(controller/app.py &amp;amp; modes.py)&lt;/i&gt;&lt;hr&gt;• 3 Operational Modes Switcher:&lt;br&gt;  1. &lt;i&gt;static_shortest_path&lt;/i&gt;&lt;br&gt;  2. &lt;i&gt;reactive_sdn&lt;/i&gt;&lt;br&gt;  3. &lt;b&gt;full_ai_qos_ff (Proposed)&lt;/b&gt;&lt;br&gt;• OFPPortStatsRequest Polling Loop&lt;br&gt;• Asynchronous OFPPortStatus Handler" vertex="1">
          <mxGeometry height="145" width="240" x="930" y="45" as="geometry" />
        </mxCell>
