        <mxCell id="title_banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=15;fontStyle=1;align=center;" value="AI-Driven QoS-Aware Predictive Traffic Engineering &amp; Self-Healing in SDN-Based Edge Networks&#xa;Three-Tier Closed-Loop System Architecture (Release v1.0)" vertex="1">
          <mxGeometry height="50" width="1200" x="50" y="20" as="geometry" />
        </mxCell>
        <mxCell id="tier_ai" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;fontColor=#5b21b6;fontSize=13;fontStyle=1;startSize=30;rounded=1;" value="TIER 1: APPLICATION &amp; AI PLANE (PyTorch Runtime Engine)" vertex="1">
          <mxGeometry height="190" width="1200" x="50" y="90" as="geometry" />
        </mxCell>
        <mxCell id="ai_preproc" parent="tier_ai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Telemetry Preprocessor&lt;/b&gt;&lt;br&gt;&lt;i&gt;(ai-model/ai_loop.py)&lt;/i&gt;&lt;hr&gt;• 5-Second Telemetry Ingestion&lt;br&gt;• Sliding Window Buffer (&lt;b&gt;W = 12 steps&lt;/b&gt;)&lt;br&gt;• Feature Scaling &amp;amp; Delta Tx/Rx Bytes&lt;br&gt;• Missing Counter Smoothing" vertex="1">
          <mxGeometry height="125" width="250" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="ai_lstm" parent="tier_ai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;PyTorch LSTM Forecaster&lt;/b&gt;&lt;br&gt;&lt;i&gt;(checkpoints/lstm_model.pt)&lt;/i&gt;&lt;hr&gt;• 2-Layer Recurrent LSTM Network&lt;br&gt;• &lt;b&gt;Inference Latency: 14.8 ms&lt;/b&gt;&lt;br&gt;• Forecast Horizon: 15–30s ahead&lt;br&gt;• Predicts Port Bandwidth Utilization" vertex="1">
          <mxGeometry height="125" width="250" x="340" y="45" as="geometry" />
        </mxCell>
        <mxCell id="ai_anomaly" parent="tier_ai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Statistical Anomaly Detector&lt;/b&gt;&lt;br&gt;&lt;i&gt;(ai-model/ai_loop.py)&lt;/i&gt;&lt;hr&gt;• Residual Analysis (Actual vs Pred)&lt;br&gt;• MSE Threshold Triggering&lt;br&gt;• Sudden Spike / Silence Detection&lt;br&gt;• Pre-Congestion Alert Generator" vertex="1">
          <mxGeometry height="125" width="240" x="640" y="45" as="geometry" />
        </mxCell>
        <mxCell id="ai_healing" parent="tier_ai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Self-Healing Decision Engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;(self_healing_module.py)&lt;/i&gt;&lt;hr&gt;• Congestion Saturation Check (&amp;gt;85%)&lt;br&gt;• &lt;b&gt;15s Cooldown Timer &amp;amp; Hysteresis&lt;/b&gt;&lt;br&gt;• Anti-Route Oscillation Logic&lt;br&gt;• Generates &lt;b&gt;PROACTIVE_REROUTE_BULK&lt;/b&gt;" vertex="1">
          <mxGeometry height="125" width="240" x="930" y="45" as="geometry" />
        </mxCell>
        <mxCell id="ai_e1" edge="1" parent="tier_ai" source="ai_preproc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7c3aed;strokeWidth=2;fontSize=10;fontColor=#5b21b6;" target="ai_lstm" value="Normalized Window">
