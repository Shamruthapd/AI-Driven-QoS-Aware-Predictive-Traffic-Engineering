# Normalize line endings for the repository's text files.
# Files are authored/stored with LF; Windows checkouts stay LF so Git
# does not report spurious modifications (autocrlf CRLF round-trips).
*.py    text eol=lf
*.sh    text eol=lf
*.csv   text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.drawio text eol=lf