# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
.hypothesis/
.mypy_cache/

# Runtime logs
logs/
*.log

# Temporary files
*.tmp
*.temp
*.swp
*.swo
tempCodeRunnerFile.py

# OS-generated files
.DS_Store
Thumbs.db

# IDE/editor settings
.vscode/
.idea/

# Python build/package artifacts
build/
dist/
*.egg-info/
.eggs/

# Environment and secret files
.env
.envrc

# Jupyter generated checkpoints
.ipynb_checkpoints/

# Project-generated local artifacts
*.bak
